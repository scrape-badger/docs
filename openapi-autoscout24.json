              "enum": [
                "best_match",
                "price_asc",
                "price_desc",
                "mileage_asc",
                "mileage_desc",
                "registration_asc",
                "registration_desc",
                "power_asc",
                "power_desc",
                "newest"
              ],
              "type": "string",
              "default": "best_match",
              "title": "Sort By"
            }
          },
