                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Condition"
            }
          },
          {
            "name": "zip",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 10
                },
                {
                  "type": "null"
                }
