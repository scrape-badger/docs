  "paths": {
    "/v1/autoscout24/search": {
      "get": {
        "tags": [
          "AutoScout24"
        ],
        "summary": "Search vehicles",
        "description": "Search live vehicle cards, seller/location information and current filter taxonomy.\n\nBrowsing is capped at 200 pages (normally 20 cards each). Narrow the query\nto reach more inventory. Empty results cost zero credits. Listing detail\nis not included in this API.",
        "operationId": "autoscout24_search_vehicles",
        "parameters": [
          {
            "name": "market",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "de",
                "at",
                "be",
                "es",
                "fr",
                "it",
                "lu",
                "nl"
              ],
              "type": "string",
              "default": "de",
              "title": "Market"
            }
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native make slug, e.g. volkswagen or bmw.",
              "title": "Make"
            },
            "description": "Native make slug, e.g. volkswagen or bmw."
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native model slug, e.g. golf. Requires make.",
              "title": "Model"
            },
            "description": "Native model slug, e.g. golf. Requires make."
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Price Min"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Price Max"
            }
          },
          {
            "name": "mileage_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Kilometres.",
              "title": "Mileage Min"
            },
            "description": "Kilometres."
          },
          {
            "name": "mileage_max",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
