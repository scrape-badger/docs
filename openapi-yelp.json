            },
            "type": "array",
            "title": "Related Searches"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "fetched_at": {
            "type": "string",
            "title": "Fetched At"
          },
          "fetched_utc": {
            "type": "number",
            "title": "Fetched Utc"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "market",
          "query",
          "location",
          "location_resolved",
          "query_matched",
          "total_results",
          "page",
          "page_size",
          "total_pages",
          "has_next_page",
          "results",
          "ads",
          "filters",
          "related_searches",
          "source_url",
          "fetched_at",
