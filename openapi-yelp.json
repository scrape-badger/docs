            "title": "Name"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "domain",
          "language",
          "currency"
        ],
        "title": "YelpMarket"
