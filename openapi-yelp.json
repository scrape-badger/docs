          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "selected": {
            "type": "boolean",
            "title": "Selected"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "value",
          "text",
          "selected"
