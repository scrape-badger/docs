  "paths": {
    "/v1/brave/search": {
      "get": {
        "summary": "Web search",
        "description": "Native Brave organic results, rich source blocks and page metadata. Seven credits.",
        "operationId": "brave_web_search",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Native Brave search query",
              "title": "Query"
            },
            "description": "Native Brave search query"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "us",
                "all",
                "ar",
                "au",
                "at",
                "be",
                "br",
                "ca",
                "cl",
                "cn",
                "dk",
                "fi",
                "fr",
                "de",
                "gr",
                "hk",
                "in",
                "id",
                "it",
                "jp",
                "kr",
                "my",
                "mx",
                "nl",
                "nz",
                "no",
                "ph",
                "pl",
                "pt",
                "ru",
                "sa",
                "sg",
                "za",
                "es",
                "se",
                "ch",
                "tw",
                "tr",
                "gb"
              ],
              "type": "string",
              "description": "Native result region; see /locales",
              "default": "us",
              "title": "Country"
            },
            "description": "Native result region; see /locales"
          },
          {
            "name": "ui_language",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "en-us",
                "az",
                "id",
                "ms",
                "br",
                "ca",
                "cs",
                "cy",
                "da",
                "de-de",
                "et",
                "en-ca",
                "en-in",
                "en-gb",
                "es",
                "eu",
                "fr-ca",
                "fr-fr",
                "gl",
                "hr",
                "it",
                "sw-ke",
                "lv",
                "lt",
                "hu",
                "nl",
                "nb",
                "pl",
                "pt-br",
                "ro",
                "sq-al",
                "sk",
                "sl",
                "sr-latn",
                "fi-fi",
                "sv",
                "vi",
                "tr",
                "el",
                "bg",
                "ru",
                "sr",
                "uk",
                "ka",
                "th",
                "ko",
                "zh",
                "zh-tw",
                "ja-jp"
              ],
              "type": "string",
              "description": "UI labels/date language; does not restrict result language",
              "default": "en-us",
              "title": "Ui Language"
            },
            "description": "UI labels/date language; does not restrict result language"
          },
          {
            "name": "safe_search",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "off",
                "moderate",
                "strict"
              ],
              "type": "string",
              "default": "moderate",
              "title": "Safe Search"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "description": "1-based native page ordinal",
              "default": 1,
              "title": "Page"
            },
            "description": "1-based native page ordinal"
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "description": "Slice one native page; does not change native page boundaries",
              "default": 20,
              "title": "Count"
            },
            "description": "Slice one native page; does not change native page boundaries"
          },
          {
            "name": "freshness",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "any",
                "day",
                "week",
                "month",
                "year"
              ],
              "type": "string",
              "default": "any",
              "title": "Freshness"
            }
          },
          {
            "name": "spellcheck",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Allow native spelling correction",
              "default": false,
              "title": "Spellcheck"
            },
            "description": "Allow native spelling correction"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BraveSearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "tags": [
          "Brave"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "x-availability": "active"
      }
    },
